# ==========================================
# FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==========================================
# Vite exposes variables prefixed with VITE_ to client code.
# NEVER put private API keys (like GEMINI_API_KEY) in this file!
# All Gemini API calls must be proxied through the Express backend.

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api

# Application Metadata
VITE_APP_TITLE=Hacktec Application
VITE_APP_ENV=development
