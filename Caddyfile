{$DOMAIN} {
	encode zstd gzip

	# API: puerto de backend/src/config/env.config.js (PORT, por defecto 5000)
	@api path /api /api/*
	handle @api {
		reverse_proxy api:5000
	}

	# Frontend como PWA: cualquier ruta que no sea archivo cae en index.html
	handle {
		root * /srv
		try_files {path} /index.html

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"

		file_server
	}
}
