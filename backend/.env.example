# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
# Local:  postgresql://postgres:TU_PASSWORD@localhost:5432/otzo
# Tiger:  la "Service URL" de Tiger Console (Connect), termina en ?sslmode=require
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/otzo
DB_SSL=false

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Authentication & Security
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
JWT_EXPIRES_IN=1d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_in_production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ElevenLabs (voz de la cajera)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
